#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - jq

write_files:
  - path: /etc/plenum/compose.yaml
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, compose_content)}
  - path: /etc/plenum/Caddyfile
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, caddy_content)}
  - path: /etc/plenum/realm-plenum.json
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, realm_content)}
  - path: /etc/plenum/livekit.yaml
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, livekit_content)}
  - path: /usr/local/sbin/plenum-fetch-secrets
    owner: root:root
    permissions: "0750"
    content: |
      ${indent(6, fetch_secrets)}
  - path: /usr/local/sbin/plenum-private-image-pull
    owner: root:root
    permissions: "0750"
    content: |
      ${indent(6, private_image_pull)}
  - path: /etc/systemd/system/plenum.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Plenum AWS Free-plan staging
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/etc/plenum
      RuntimeDirectory=plenum
      RuntimeDirectoryMode=0700
      Environment=DOCKER_CONFIG=/run/plenum/docker
      Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
      ExecStartPre=/usr/local/sbin/plenum-fetch-secrets
      ExecStartPre=/usr/local/sbin/plenum-private-image-pull ${application_image}
      ExecStart=/usr/bin/docker compose --file /etc/plenum/compose.yaml up --detach --remove-orphans
      ExecStop=/usr/bin/docker compose --file /etc/plenum/compose.yaml down
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [sh, -c, "getent group 2000 >/dev/null 2>&1 || groupadd --system --gid 2000 plenum-secrets"]
  - [install, -d, -o, root, -g, "2000", -m, "0750", /etc/plenum/secrets]
  - [sh, -c, "command -v aws >/dev/null 2>&1 || snap install aws-cli --classic"]
  - [ln, -sfn, /snap/bin/aws, /usr/local/bin/aws]
  - [aws, --version]
  - [systemctl, enable, --now, docker]
  - [sh, -c, "systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || systemctl enable --now amazon-ssm-agent.service || true"]
  - [systemctl, daemon-reload]
  - [systemctl, enable, plenum.service]
  - [sh, -c, "echo 'Plenum is staged but intentionally stopped until the six SSM SecureString parameters are populated.' > /etc/plenum/DEPLOYMENT_STATUS"]
