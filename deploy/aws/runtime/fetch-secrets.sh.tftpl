#!/usr/bin/env bash
set -euo pipefail
umask 077

secret_group_id="2000"
install -d -o root -g "$secret_group_id" -m 0750 /etc/plenum/secrets

fetch_parameter() {
  local parameter_name="$1"
  local target_name="$2"
  local temporary_file
  temporary_file="$(mktemp /run/plenum-secret.XXXXXX)"
  trap 'rm -f "$temporary_file"' RETURN
  aws ssm get-parameter \
    --region "${region}" \
    --name "$parameter_name" \
    --with-decryption \
    --query Parameter.Value \
    --output text \
    --no-cli-pager > "$temporary_file"
  test -s "$temporary_file"
  install -o root -g "$secret_group_id" -m 0640 "$temporary_file" "/etc/plenum/secrets/$target_name"
  rm -f "$temporary_file"
  trap - RETURN
}

fetch_parameter "${parameter_prefix}/application" "application.json"
fetch_parameter "${parameter_prefix}/postgres-password" "postgres-password"
fetch_parameter "${parameter_prefix}/keycloak-admin-password" "keycloak-admin-password"
fetch_parameter "${parameter_prefix}/test-user-password" "test-user-password"
fetch_parameter "${parameter_prefix}/livekit-keys" "livekit-keys.yaml"
fetch_parameter "${parameter_prefix}/operations" "operations.json"

# Installer versions before the key-file contract fix stored a full LiveKit
# `keys:` fragment. Normalize that legacy shape without exposing or rotating it.
if [[ "$(head -n 1 /etc/plenum/secrets/livekit-keys.yaml)" == "keys:" ]]; then
  temporary_key_file="$(mktemp /run/plenum-livekit-keys.XXXXXX)"
  tail -n +2 /etc/plenum/secrets/livekit-keys.yaml | sed 's/^  //' > "$temporary_key_file"
  test -s "$temporary_key_file"
  install -o root -g "$secret_group_id" -m 0640 "$temporary_key_file" /etc/plenum/secrets/livekit-keys.yaml
  rm -f "$temporary_key_file"
fi
