PLENUM_APPLICATION_IMAGE=plenum-platform:0.1.0
PLENUM_DEPLOYMENT_PROFILE=institutional
DATABASE_URL=postgres://plenum_owner:replace-me@database:5432/plenum
S3_ENDPOINT=http://storage:8333
S3_BUCKET=plenum
OIDC_ISSUER=https://identity.plenum.lan:8443/realms/plenum
OIDC_PROVIDER_KEY=local-keycloak
OIDC_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
OIDC_CLIENT_ID=plenum-web
OIDC_REDIRECT_URI=https://plenum.example.invalid/auth/callback
MEDIA_URL=ws://media:7880
MEDIA_API_KEY=replace-me
MEDIA_API_SECRET=replace-with-at-least-16-characters
MEDIA_ADAPTER_DIGEST=sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
PLENUM_PUBLIC_BASE_URL=https://plenum.example.invalid
INVITATION_DELIVERY_ENDPOINT=https://notifications.plenum.lan/v1/messages
INVITATION_DELIVERY_BEARER_TOKEN=replace-with-a-random-provider-secret
INVITATION_DELIVERY_WEBHOOK_TOKEN=replace-with-a-different-random-webhook-secret
PLENUM_DEPLOYMENT_ID=00000000-0000-4000-8000-000000000002
PLENUM_RETENTION_ACTOR_PERSON_ID=00000000-0000-4000-8000-000000000003
PLENUM_TRUST_PROXY=0
FLOOR_TOKEN_SECRET=replace-with-a-random-secret
POSTGRES_USER=plenum_owner
POSTGRES_PASSWORD_FILE=./secrets/postgres-password
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-me
KEYCLOAK_DATABASE_URL=jdbc:postgresql://database:5432/plenum
KEYCLOAK_DATABASE_USERNAME=plenum_owner
KEYCLOAK_DATABASE_PASSWORD=replace-me
KEYCLOAK_HOSTNAME=identity.plenum.lan
KEYCLOAK_TLS_CERTIFICATE=./secrets/identity-tls.crt
KEYCLOAK_TLS_PRIVATE_KEY=./secrets/identity-tls.key
LIVEKIT_KEYS_FILE=./secrets/livekit-keys.yaml

