{
  admin off
  servers {
    protocols h1 h2
  }
}

${application_hostname} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  reverse_proxy application:8080 {
    header_down -Strict-Transport-Security
  }
}

${identity_hostname} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  reverse_proxy identity:8080
}

${media_hostname} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  reverse_proxy media:7880
}

${notifications_hostname} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  handle /v1/messages {
    reverse_proxy application:8080
  }
  handle /v1/events/postmark {
    reverse_proxy application:8080
  }
  respond "Not Found" 404
}
