{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plenum.local/promptbook/task.schema.json",
  "title": "Plenum Studio promptbook task manifest",
  "type": "array",
  "items": { "$ref": "#/$defs/task" },
  "$defs": {
    "id": { "type": "string", "pattern": "^(PS-[0-9]{3}|REQ-[0-9]{3}|INV-[0-9]{3}|AC-[0-9]{2}|SYNC-[0-9]{2}|VOTE-[0-9]{2}|VOICE-[0-9]{2}|EXT-[0-9]{2}|DB-[0-9]{2}|DEC-[0-9]{2}|ADR-[0-9]{3}|OPEN-[0-9]{3})$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "slug", "phase", "title", "category", "primary_owner", "goal", "user_outcome",
        "product_requirements", "source_refs", "source_evidence", "depends_on_unratified", "prerequisites",
        "prerequisites_verified", "ready_to_execute", "inspect", "scope", "expected_paths", "non_goals",
        "implementation", "authorization_privacy", "concurrency_idempotency_versions", "deliverables",
        "migration_ids", "api_contract_ids", "test_ids", "validation_command_refs", "acceptance_criteria",
        "regression_quality_gates", "docs_continuity", "risk", "approval_gate", "implementation_state",
        "evidence", "commit_subject", "commit_body", "pr_description", "revisit_triggers"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^PS-[0-9]{3}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "phase": { "enum": ["P00", "P01", "P02", "P03", "P04", "P05", "P06", "P07", "P08", "P09", "P10", "P11"] },
        "title": { "type": "string", "minLength": 5 },
        "category": { "type": "string", "minLength": 3 },
        "primary_owner": { "type": "string", "pattern": "^Epic [A-N]$" },
        "goal": { "type": "string", "minLength": 10 },
        "user_outcome": { "type": "string", "minLength": 10 },
        "product_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(REQ-[0-9]{3}|INV-[0-9]{3})$" }, "uniqueItems": true },
        "source_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "source_evidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "depends_on_unratified": { "type": "array", "items": { "type": "string", "pattern": "^(DEC-[0-9]{2}|ADR-[0-9]{3}|OPEN-[0-9]{3})$" }, "uniqueItems": true },
        "prerequisites": { "type": "array", "items": { "type": "string", "pattern": "^PS-[0-9]{3}$" }, "uniqueItems": true },
        "prerequisites_verified": { "type": "boolean" },
        "ready_to_execute": { "type": "boolean" },
        "inspect": { "$ref": "#/$defs/nonEmptyStrings" },
        "scope": { "$ref": "#/$defs/nonEmptyStrings" },
        "expected_paths": { "$ref": "#/$defs/nonEmptyStrings" },
        "non_goals": { "$ref": "#/$defs/nonEmptyStrings" },
        "implementation": { "$ref": "#/$defs/nonEmptyStrings" },
        "authorization_privacy": { "$ref": "#/$defs/nonEmptyStrings" },
        "concurrency_idempotency_versions": { "$ref": "#/$defs/nonEmptyStrings" },
        "deliverables": { "$ref": "#/$defs/nonEmptyStrings" },
        "migration_ids": { "$ref": "#/$defs/strings" },
        "api_contract_ids": { "$ref": "#/$defs/strings" },
        "test_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(AC-[0-9]{2}|SYNC-[0-9]{2}|VOTE-[0-9]{2}|VOICE-[0-9]{2}|EXT-[0-9]{2}|DB-[0-9]{2}|PS-[0-9]{3}-T[0-9]{2})$" }, "uniqueItems": true },
        "validation_command_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStrings" },
        "regression_quality_gates": { "$ref": "#/$defs/nonEmptyStrings" },
        "docs_continuity": { "$ref": "#/$defs/nonEmptyStrings" },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "approval_gate": { "type": "string", "minLength": 1 },
        "implementation_state": { "enum": ["planned", "blocked", "in_progress", "implemented", "verified", "superseded"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "commit_subject": { "type": "string", "minLength": 5, "maxLength": 72 },
        "commit_body": { "type": "string", "minLength": 20 },
        "pr_description": { "type": "string", "minLength": 20 },
        "revisit_triggers": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
