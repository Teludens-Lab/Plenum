{
  "name": "plenum-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run build --silent && node scripts/contract-lint.mjs",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit --pretty false",
    "test": "npm run build --silent && node --test tests/platform/contracts.test.mjs",
    "build": "tsc --build --pretty false"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
