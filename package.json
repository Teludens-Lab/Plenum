{
  "name": "plenum-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run build --silent && node scripts/contract-lint.mjs",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit --pretty false",
    "test": "npm run build --silent && node --test tests/platform/contracts.test.mjs packages/policy-engine/test/policy.test.mjs packages/release-compiler/test/compiler.test.mjs packages/sync-client/test/sync-client.test.mjs apps/server/test/identity.unit.test.mjs",
    "test:integration": "npm run build --silent && node --test apps/server/test/identity.integration.test.mjs apps/server/test/object-store.integration.test.mjs",
    "test:db": "npm run build --silent && node --test apps/server/test/identity.integration.test.mjs",
    "test:s3": "npm run build --silent && node --test apps/server/test/object-store.integration.test.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.mjs",
    "test:a11y": "playwright test --config tests/e2e/playwright.config.mjs --grep @a11y",
    "build": "tsc --build --pretty false && npm run build:web --workspace @plenum/runtime-web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
