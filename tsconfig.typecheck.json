{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@plenum/event-contracts": ["packages/event-contracts/src/index.ts"],
      "@plenum/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@plenum/release-compiler": ["packages/release-compiler/src/index.ts"],
      "@plenum/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@plenum/extension-host": ["packages/extension-host/src/index.ts"],
      "@plenum/simulation-schema": ["packages/simulation-schema/src/index.ts"],
      "@plenum/workflow-engine": ["packages/workflow-engine/src/index.ts"],
      "@plenum/sync-client": ["packages/sync-client/src/index.ts"],
      "@plenum/server": ["apps/server/src/index.ts"],
      "@plenum/runtime-web": ["apps/runtime-web/src/index.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "packages/*/src/**/*.ts"
  ]
}
